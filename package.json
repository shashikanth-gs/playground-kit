  "license": "MIT",
  "author": {
    "name": "Shashi Kanth G S",
    "url": "https://shashikanth.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashikanth-gs/playground-kit.git"
  },
  "homepage": "https://github.com/shashikanth-gs/playground-kit#readme",
  "description": "UI components for interactive technical playgrounds. Created and maintained by Shashi Kanth G S, built on shadcn/ui and Base UI.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run kit && next build",
    "deploy:cloudflare": "node scripts/cloudflare-static.mjs deploy",
    "check:cloudflare": "node scripts/cloudflare-static.mjs check",
    "typecheck": "tsc --noEmit",
    "kit": "node scripts/package-kit.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.151.0"
  }
}
